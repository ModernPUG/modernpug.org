{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "creativeorange/gravatar": "^1.0.26",
        "doctrine/dbal": "^4.4",
        "embed/embed": "^4.4",
        "guzzlehttp/guzzle": "^7.12",
        "laminas/laminas-feed": "^2.26",
        "laminas/laminas-http": "^2.23",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/slack-notification-channel": "^3.8",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "php-flasher/flasher-toastr-laravel": "^2.6",
        "sentry/sentry-laravel": "^4.26",
        "socialiteproviders/discord": "^4.1",
        "socialiteproviders/slack": "^5.2",
        "spatie/laravel-permission": "^8.0",
        "symfony/dom-crawler": "^8.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24",
        "itsgoingd/clockwork": "^5.3",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.2",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan optimize --env=testing",
            "@php artisan db:wipe --env=testing",
            "@php artisan migrate --seed --env=testing",
            "@php artisan test --env=testing",
            "@php artisan config:clear --env=testing"
        ],
        "rebuild": [
            "@php artisan migrate:fresh --ansi",
            "@php artisan db:seed --ansi",
            "@php artisan ide-helper:model -WR --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
